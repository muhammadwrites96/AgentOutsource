# Copy to .env.local for local `vercel dev`, and set the same values
# under Vercel → Project → Settings → Environment Variables for production.

# --- Database (auto-filled if you use Vercel Postgres / Storage tab) ---
# POSTGRES_URL=

# --- Email notifications (Gmail SMTP) ---
# 1. Enable 2-Step Verification on the sending Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=agentoutsourceofficial@gmail.com

# --- Admin page password (pages/admin.html) ---
ADMIN_PASSWORD=
